{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "data-service-route": {
        "ClusterId": "data-service-cluster",
        "Match": {
          "Path": "/api/{**remainder}"
        }
      },
      "realtime-service-route": {
        "ClusterId": "realtime-service-cluster",
        "Match": {
          "Path": "/hub/{**remainder}"
        }
      }
    },
    "Clusters": {
      "data-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5128"
          }
        }
      },
      "realtime-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5200"
          }
        }
      }
    }
  }
}
