{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "",
    "Issuer":    "demo-app",
    "Audience":  "demo-app"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "auth-service-cluster",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/auth/login",
          "Methods": [ "POST" ]
        }
      },
      "auth-service-route": {
        "ClusterId": "auth-service-cluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/auth/{**remainder}"
        }
      },
      "data-service-route": {
        "ClusterId": "data-service-cluster",
        "AuthorizationPolicy": "Default",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/api/{**remainder}"
        }
      },
      "realtime-service-route": {
        "ClusterId": "realtime-service-cluster",
        "AuthorizationPolicy": "Default",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/hub/{**remainder}"
        }
      }
    },
    "Clusters": {
      "auth-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5100"
          }
        }
      },
      "data-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5128"
          }
        }
      },
      "realtime-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5200"
          }
        }
      }
    }
  }
}
