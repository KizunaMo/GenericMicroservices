{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "dev-secret-key-must-be-at-least-32-chars!!",
    "Issuer":    "demo-app",
    "Audience":  "demo-app"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-service-route": {
        "ClusterId": "auth-service-cluster",
        "Match": {
          "Path": "/auth/{**remainder}"
        }
      },
      "data-service-route": {
        "ClusterId": "data-service-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/{**remainder}"
        }
      },
      "realtime-service-route": {
        "ClusterId": "realtime-service-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/hub/{**remainder}"
        }
      }
    },
    "Clusters": {
      "auth-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5100"
          }
        }
      },
      "data-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5128"
          }
        }
      },
      "realtime-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5200"
          }
        }
      }
    }
  }
}
